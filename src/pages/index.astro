---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SkillGroups from '../components/SkillGroups.astro';
import Contact from '../components/Contact.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) =>
  import.meta.env.PROD ? data.draft !== true : true,
);

const featured = projects
  .filter((p) => p.data.featured === true)
  .sort((a, b) => a.data.order - b.data.order);

const [lead, ...rest] = featured;

const metrics = [
  { value: '80%', label: 'Faster execution' },
  { value: '95%', label: 'Code coverage' },
  { value: `${profile.yearsExperience}+`, label: 'Years experience' },
];
---

<BaseLayout>
  <Hero />

  <!-- Proof bar — the metrics do the talking -->
  <section class="border-b border-line bg-surface/60" aria-label="Key results">
    <dl class="mx-auto grid max-w-6xl grid-cols-1 divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {
        metrics.map((m, i) => (
          <div
            class="flex flex-col-reverse gap-2 px-6 py-10"
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <dt class="text-sm text-ink-muted">{m.label}</dt>
            <dd class="font-mono text-title font-semibold tracking-tight text-accent lg:text-display">
              {m.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl">
            <p class="eyebrow" data-reveal>Selected work</p>
            <h2 class="mt-3 text-h2 font-semibold tracking-tight text-ink" data-reveal>
              Featured case studies
            </h2>
          </div>
          <a
            href="/projects"
            class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-accent"
            data-reveal
          >
            All projects
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        </div>

        <div class="mt-10 space-y-5" data-reveal>
          {lead && <ProjectCard entry={lead} variant="lead" />}
          {rest.length > 0 && <ProjectGrid projects={rest} />}
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <Section
      eyebrow="About"
      title="Engineering quality into every release"
      description={profile.summary}
      linkLabel="More about me"
      linkHref="/about"
    >
      <SkillGroups />
    </Section>
  </section>

  <section class="border-t border-line bg-surface/40 py-20 sm:py-24" id="contact">
    <Section eyebrow="Contact" title="Get in touch" description="Questions about a role, a framework, or a talk? I read every message.">
      <Contact />
    </Section>
  </section>
</BaseLayout>
