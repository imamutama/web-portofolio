---
import { experience } from '../data/experience';
---

<ol class="ml-3 space-y-12 border-l border-line">
  {
    experience.map((item) => (
      <li class="relative pl-8" data-reveal>
        <span
          class="absolute -left-[9px] top-1.5 size-4 rounded-full border-2 border-accent bg-page"
          aria-hidden="true"
        ></span>

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-h3 font-semibold tracking-tight text-ink">{item.title}</h3>
          <span class="font-mono text-sm text-accent">{item.range}</span>
        </div>

        <p class="mt-1.5 text-ink-muted">{item.company}</p>

        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-ink-muted">
          {item.bullets.map((bullet) => (
            <li class="flex gap-2.5">
              <span class="mt-[7px] size-1 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>
