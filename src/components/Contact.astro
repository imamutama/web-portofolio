---
import { Check, Copy, ExternalLink, Github, Linkedin, Mail } from 'lucide-astro';
import { site } from '../data/site';
import ContactForm from './ContactForm.astro';
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <div class="rounded-2xl border border-line bg-surface p-7" data-reveal>
    <h3 class="text-h3 font-semibold tracking-tight text-ink">Send a message</h3>
    <p class="mt-2 text-sm text-ink-muted">I usually reply within a day or two.</p>
    <div class="mt-6">
      <ContactForm />
    </div>
  </div>

  <div class="flex flex-col gap-5" data-reveal>
    <div class="rounded-2xl border border-line bg-surface p-7">
      <h3 class="text-h3 font-semibold tracking-tight text-ink">Prefer email?</h3>
      <p class="mt-3 max-w-[52ch] text-ink-muted">
        Open to discussing automation frameworks, CI/CD, and AI-assisted testing.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-hover"
        >
          <Mail size={16} />
          Email me
        </a>

        <button
          type="button"
          id="copy-email"
          data-email={site.email}
          class="copy-btn inline-flex items-center gap-2 rounded-md border border-line bg-raised px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent-line hover:text-accent"
        >
          <Copy size={15} class="icon-copy" />
          <Check size={15} class="icon-check text-accent" />
          <span id="copy-email-label">Copy email</span>
        </button>
      </div>

      <p class="mt-5 font-mono text-sm text-ink-faint">{site.email}</p>
    </div>

    <a
      href={site.github}
      target="_blank"
      rel="noopener noreferrer"
      class="card group flex items-center justify-between rounded-2xl border border-line bg-surface p-6"
    >
      <div class="flex items-center gap-4">
        <span class="flex size-11 items-center justify-center rounded-xl border border-line bg-raised text-ink-muted">
          <Github size={20} />
        </span>
        <div>
          <p class="font-medium text-ink">GitHub</p>
          <p class="font-mono text-sm text-ink-faint">@imamutama</p>
        </div>
      </div>
      <ExternalLink size={16} class="text-ink-faint" aria-hidden="true" />
    </a>

    {
      site.linkedin && (
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="card group flex items-center justify-between rounded-2xl border border-line bg-surface p-6"
        >
          <div class="flex items-center gap-4">
            <span class="flex size-11 items-center justify-center rounded-xl border border-line bg-raised text-ink-muted">
              <Linkedin size={20} />
            </span>
            <div>
              <p class="font-medium text-ink">LinkedIn</p>
              <p class="font-mono text-sm text-ink-faint">Connect</p>
            </div>
          </div>
          <ExternalLink size={16} class="text-ink-faint" aria-hidden="true" />
        </a>
      )
    }
  </div>
</div>

<script>
  const btn = document.getElementById('copy-email');
  const label = document.getElementById('copy-email-label');
  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email ?? '';
    if (!label) return;
    try {
      await navigator.clipboard.writeText(email);
      btn.classList.add('copied');
      label.textContent = 'Copied';
      window.setTimeout(() => {
        btn.classList.remove('copied');
        label.textContent = 'Copy email';
      }, 2000);
    } catch {
      label.textContent = 'Select & copy';
    }
  });
</script>
