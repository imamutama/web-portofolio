---
import { Github, Linkedin, Mail } from 'lucide-astro';
import { site } from '../data/site';
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-mono text-sm text-ink-faint">© {new Date().getFullYear()} {site.name}</p>
      <p class="mt-1 text-sm text-ink-faint">QA Automation Engineer · {site.location}</p>
    </div>

    <div class="flex items-center gap-1.5">
      <a
        href={`mailto:${site.email}`}
        class="flex size-9 items-center justify-center rounded-md text-ink-muted transition-colors hover:text-ink"
        aria-label="Email"
      >
        <Mail size={18} />
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-9 items-center justify-center rounded-md text-ink-muted transition-colors hover:text-ink"
        aria-label="GitHub"
      >
        <Github size={18} />
      </a>
      {
        site.linkedin && (
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex size-9 items-center justify-center rounded-md text-ink-muted transition-colors hover:text-ink"
            aria-label="LinkedIn"
          >
            <Linkedin size={18} />
          </a>
        )
      }
    </div>
  </div>
</footer>
