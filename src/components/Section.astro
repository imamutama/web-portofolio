---
import { ArrowRight } from 'lucide-astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  level?: 2 | 3;
  linkLabel?: string;
  linkHref?: string;
  className?: string;
}

const {
  eyebrow,
  title,
  description,
  id,
  level = 2,
  linkLabel,
  linkHref,
  className,
} = Astro.props;

const Heading = `h${level}` as const;
---

<section id={id} class:list={['mx-auto max-w-6xl px-6', className]}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-2xl">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <Heading class="mt-3 text-h2 font-semibold tracking-tight text-ink" data-reveal>
        {title}
      </Heading>
      {description && (
        <p class="mt-4 max-w-[72ch] text-body-lg text-ink-muted" data-reveal>
          {description}
        </p>
      )}
    </div>

    {linkLabel && linkHref && (
      <a
        href={linkHref}
        class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-accent"
        data-reveal
      >
        {linkLabel}
        <ArrowRight size={15} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    )}
  </div>

  <div class="mt-10">
    <slot />
  </div>
</section>
